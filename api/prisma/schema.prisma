generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "mysql"
}

model Usuario {
  id       BigInt    @id @default(autoincrement())
  name     String?   @db.VarChar(255)
  enquetes Enquete[]

  @@map("usuarios")
}

model Enquete {
  id               BigInt   @id @default(autoincrement())
  title            String?  @db.VarChar(255)
  createdAt        DateTime? @map("created_at") @db.DateTime(6)
  updatedAt        DateTime? @map("updated_at") @db.DateTime(6)
  voteRequireLogin Boolean   @map("vote_require_login")
  expirationDate   DateTime? @map("expiration_date") @db.DateTime(6)
  usuarioId        BigInt?   @map("usuario_id")
  usuario          Usuario?  @relation(fields: [usuarioId], references: [id])
  opcoes           Opcao[]

  @@index([usuarioId])
  @@map("enquetes")
}

model Opcao {
  id        BigInt   @id @default(autoincrement())
  name      String?  @db.VarChar(255)
  votes     BigInt?  @default(0) @map("qtde_votos")
  enqueteId BigInt?  @map("enquete_id")
  enquete   Enquete? @relation(fields: [enqueteId], references: [id])

  @@index([enqueteId])
  @@map("opcoes")
}
