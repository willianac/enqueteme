generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "mysql"
}

model Usuario {
  id            BigInt    @id @default(autoincrement())
  googleSubject String    @unique @map("google_subject") @db.VarChar(255)
  email         String    @unique @db.VarChar(320)
  name          String    @db.VarChar(255)
  enquetes      Enquete[]
  sessoes       Sessao[]
  votos         Voto[]

  @@map("usuarios")
}

model Sessao {
  tokenHash  String   @id @map("token_hash") @db.Char(64)
  createdAt  DateTime @default(now()) @map("created_at") @db.DateTime(6)
  expiresAt  DateTime @map("expires_at") @db.DateTime(6)
  usuarioId  BigInt   @map("usuario_id")
  usuario    Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@index([expiresAt])
  @@map("sessoes")
}

model Enquete {
  id               BigInt   @id @default(autoincrement())
  title            String?  @db.VarChar(255)
  createdAt        DateTime? @map("created_at") @db.DateTime(6)
  updatedAt        DateTime? @map("updated_at") @db.DateTime(6)
  voteRequireLogin Boolean   @map("vote_require_login")
  expirationDate   DateTime? @map("expiration_date") @db.DateTime(6)
  usuarioId        BigInt?   @map("usuario_id")
  usuario          Usuario?  @relation(fields: [usuarioId], references: [id])
  opcoes           Opcao[]
  votos            Voto[]

  @@index([usuarioId])
  @@map("enquetes")
}

model Opcao {
  id        BigInt   @id @default(autoincrement())
  name      String?  @db.VarChar(255)
  votes     BigInt?  @default(0) @map("qtde_votos")
  enqueteId BigInt?  @map("enquete_id")
  enquete   Enquete? @relation(fields: [enqueteId], references: [id], onDelete: Cascade)
  votos     Voto[]

  @@index([enqueteId])
  @@map("opcoes")
}

model Voto {
  id        BigInt   @id @default(autoincrement())
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(6)
  enqueteId BigInt   @map("enquete_id")
  opcaoId   BigInt   @map("opcao_id")
  usuarioId BigInt?  @map("usuario_id")
  enquete   Enquete  @relation(fields: [enqueteId], references: [id], onDelete: Cascade)
  opcao     Opcao    @relation(fields: [opcaoId], references: [id], onDelete: Cascade)
  usuario   Usuario? @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@unique([enqueteId, usuarioId])
  @@index([enqueteId])
  @@index([opcaoId])
  @@index([usuarioId])
  @@map("votos")
}
